---
import type {CollectionEntry} from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";

import styles from "./BlogPost.module.css";
import BaseLayout from "./BaseLayout.astro";
import {Image} from 'astro:assets';
import Prose from "../components/Prose/Prose.astro";

type Props = CollectionEntry<"garden">["data"];

const {title, published, description, created, image} = Astro.props;
---

<BaseLayout title={title} description={description} image={image?.src}>
    <article>
        <div class="hero-image">
            {image &&
                    <Image src={image} alt=""/>}
        </div>
        <Prose>

            <div class="title">
                <div class="date">
                    <FormattedDate date={published}/>
                </div>
                <h1>{title}</h1>
                <hr/>
            </div>
            <div id="content">
                <slot/>
            </div>
        </Prose>
    </article>
</BaseLayout>

<style>

    #content :global(p:has(> img:nth-last-child(2):first-child)) {
        display: grid;
        grid-template-columns: 1fr;
        grid-column-gap: 1rem;
    }

    #content :global(p:has(> img:nth-last-child(2):first-child) img) {
        margin-bottom: 1rem;
    }
    /* three items
    img:first-child:nth-last-child(3),
    img:first-child:nth-last-child(3) ~ img {
      float: left;
      width: calc(33.3333% - 2rem);
      margin: 0 1rem;
    }

    /* four items
    img:first-child:nth-last-child(4),
    img:first-child:nth-last-child(4) ~ img {
      float: left;
      width: calc(25% - 2rem);
      margin: 0 1rem;
    }
    */

    @media screen and (min-width: 700px) {
        main {
            width: calc(100% - 2em);
            max-width: 100%;
            margin: 4rem auto;
        }

        /* two items */
        #content :global(p:has(> img:nth-last-child(2):first-child)) {
            display: grid;
            grid-template-columns: 1fr 1fr;
            grid-column-gap: 1rem;
        }

        #content :global(p:has(> img:nth-last-child(2):first-child) img) {
            margin-bottom: 0;
        }
    }

    .hero-image {
        width: 100%;
        max-width: 960px;
        margin: 0 auto;
    }

    .hero-image img {
        display: block;
        margin: 0 auto;
        border-radius: 12px;
        box-shadow: var(--box-shadow);
    }

    .title {
        margin-bottom: 1em;
        padding: 1em 0;
        text-align: center;
        line-height: 1;
    }

    .title h1 {
        margin: 0 0 0.5em 0;
    }

    .date {
        margin-bottom: 0.5em;
        color: rgb(var(--gray));
    }

    .last-updated-on {
        font-style: italic;
    }

    #content :global(h1[id]),
    #content :global(h2[id]),
    #content :global(h3[id]),
    #content :global(h4[id]),
    #content :global(h5[id]),
    #content :global(h6[id]) {
        position: relative;
    }

    #content :global(.header-link) {
        position: absolute;
        left: -2rem;
        top: 0;
        opacity: 0;
        transition: opacity 0.2s ease;
        text-decoration: none;
        font-size: 0.8em;
        padding: 0.2rem 1rem 0.2rem 0.2rem;
        cursor: pointer;
        user-select: none;
    }

    #content :global(h1[id]:hover .header-link),
    #content :global(h2[id]:hover .header-link),
    #content :global(h3[id]:hover .header-link),
    #content :global(h4[id]:hover .header-link),
    #content :global(h5[id]:hover .header-link),
    #content :global(h6[id]:hover .header-link),
    #content :global(.header-link:hover) {
        opacity: 1;
    }

    #content :global(h1[id] .header-link) {
        color: var(--big-blue);
    }

    #content :global(h2[id] .header-link) {
        color: var(--bright-blue);
    }

    #content :global(h3[id] .header-link) {
        color: rgb(var(--green));
    }

    #content :global(h4[id] .header-link) {
        color: var(--yellow);
    }

    #content :global(h5[id] .header-link) {
        color: var(--tag);
    }

    #content :global(h6[id] .header-link) {
        color: rgb(var(--gray));
    }

    @keyframes copyPulse {
        0% {
            transform: scale(1);
            opacity: 1;
        }
        100% {
            transform: scale(1.5);
            opacity: 0;
        }
    }

    #content :global(.header-link.copied) {
        animation: copyPulse 0.6s ease-out;
    }
</style>

<script>
    // Add copy link functionality to headers
    function setupHeaderLinks() {
        const headers = document.querySelectorAll('#content h1[id], #content h2[id], #content h3[id], #content h4[id], #content h5[id], #content h6[id]');

        headers.forEach(header => {
            // Create link icon
            const link = document.createElement('span');
            link.className = 'header-link';
            link.innerHTML = '#';
            link.setAttribute('aria-label', 'Copy link to this section');
            link.setAttribute('title', 'Copy link');

            // Add click handler
            link.addEventListener('click', async (e) => {
                e.preventDefault();
                e.stopPropagation();

                const url = `${window.location.origin}${window.location.pathname}#${header.id}`;

                try {
                    await navigator.clipboard.writeText(url);
                    link.classList.add('copied');
                    setTimeout(() => {
                        link.classList.remove('copied');
                    }, 1500);
                } catch (err) {
                    console.error('Failed to copy:', err);
                }
            });

            header.insertBefore(link, header.firstChild);
        });
    }

    // Run on page load
    setupHeaderLinks();

    // Re-run after view transitions if using Astro view transitions
    document.addEventListener('astro:page-load', setupHeaderLinks);
</script>
