---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Prose from "../../components/Prose/Prose.astro";
import {
  groupByYearMonth,
  renderStarRating,
  STREAM_TYPES,
  type StreamTypeKey,
} from "../../utils/stream";

export function getStaticPaths() {
  return Object.keys(STREAM_TYPES).map((type) => ({
    params: { type },
  }));
}

const { type } = Astro.params as { type: StreamTypeKey };
const config = STREAM_TYPES[type];
const items = await config.fetchItems();
const itemsByYearMonth = groupByYearMonth(items);
---

<BaseLayout title={`Stream - ${config.label}`} description={`${config.label} from my stream`}>
  <Prose>
    <h1><a href="/stream">Stream</a> / {config.label}</h1>

    {Object.entries(itemsByYearMonth)
      .sort(([a], [b]) => Number(b) - Number(a))
      .map(([year, months]) => (
        <section class="year-section">
          <h2>{year}</h2>

          {Object.entries(months).map(([month, monthItems]) => (
            <div class="month-section">
              <h3>
                {month}
                <span class="count">{monthItems.length} {monthItems.length === 1 ? 'item' : 'items'}</span>
              </h3>

              {type === 'toots' ? (
                <ul class="item-list toots-list">
                  {monthItems.map((item) => (
                    <li class="item toot">
                      <span class="category-label"></span>
                      <div class="item-details toot-content">
                        <div class="toot-text" set:html={item.data.body} />
                        <p class="toot-meta">
                          <a href={item.data.data.url} target="_blank" rel="noopener noreferrer">
                            View on Mastodon &rarr;
                          </a>
                        </p>
                      </div>
                    </li>
                  ))}
                </ul>
              ) : (
                <ul class="item-list media-grid">
                  {monthItems.map((item) => {
                    const imgWidth = 120;
                    const imgHeight = type === 'music' ? 120 : type === 'games' ? 160 : 180;
                    const hasRating = config.ratingScale && item.data.data.rating;

                    return (
                      <li class="media-item">
                        {item.data.data.image && item.data.data.link ? (
                          <a href={item.data.data.link} target="_blank" rel="noopener noreferrer" class="media-link">
                            <Image
                              src={item.data.data.image}
                              alt={item.data.data.title}
                              width={imgWidth}
                              height={imgHeight}
                            />
                            {hasRating && (
                              <div class="rating-overlay" set:html={renderStarRating(item.data.data.rating, config.ratingScale!)} />
                            )}
                          </a>
                        ) : item.data.data.image ? (
                          <div class="media-link">
                            <Image
                              src={item.data.data.image}
                              alt={item.data.data.title}
                              width={imgWidth}
                              height={imgHeight}
                            />
                            {hasRating && (
                              <div class="rating-overlay" set:html={renderStarRating(item.data.data.rating, config.ratingScale!)} />
                            )}
                          </div>
                        ) : null}
                      </li>
                    );
                  })}
                </ul>
              )}
            </div>
          ))}
        </section>
      ))}

    {items.length === 0 && (
      <p class="empty-state">No {config.label.toLowerCase()} found.</p>
    )}
  </Prose>
</BaseLayout>

<style>
  :global(.prose) {
    width: 100%;
    max-width: 1200px;
  }

  h1 {
    font-size: 2rem;
    margin-bottom: 2rem;
  }

  h1 a {
    color: var(--link-color, #0066cc);
    text-decoration: none;
  }

  h1 a:hover {
    text-decoration: underline;
  }

  .year-section {
    margin-bottom: 3rem;
  }

  .year-section h2 {
    font-size: 1.75rem;
    margin-bottom: 1.5rem;
  }

  .month-section {
    margin-bottom: 2rem;
  }

  .month-section h3 {
    margin-bottom: 1.5rem;
  }

  .count {
    font-size: 0.875rem;
    color: var(--text-color-muted, #999);
    margin-left: 0.75rem;
    font-weight: normal;
  }

  .item-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem 0;
  }

  .media-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .media-item {
    list-style: none;
  }

  .media-link {
    display: block;
    position: relative;
    transition: opacity 0.2s, transform 0.2s;
  }

  .media-link:hover {
    opacity: 0.85;
    transform: translateY(-2px);
  }

  .media-link img,
  .media-item img {
    object-fit: cover;
    border-radius: 4px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    display: block;
  }

  .rating-overlay {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translate(-50%, 50%);
    display: flex;
    gap: 2px;
    background: rgba(0, 0, 0, 0.75);
    padding: 4px 6px;
    border-radius: 4px;
    backdrop-filter: blur(4px);
  }

  .rating-overlay .star {
    display: inline-block;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.8));
  }

  .rating-overlay .star path {
    pointer-events: none;
  }

  .toots-list {
    display: block;
  }

  .item {
    display: flex;
    overflow: hidden;
    gap: 1rem;
    margin-bottom: 1rem;
    padding: 1rem;
    border: 1px solid var(--border-color, #eee);
    border-radius: 8px;
    background: var(--bg-color, #fff);
    transition: box-shadow 0.2s;
    position: relative;
  }

  .item:hover {
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .category-label {
    position: absolute;
    top: 0rem;
    left: 0rem;
    display: inline-block;
    height: .5rem;
    width: 100%;
    font-size: 0.75rem;
    font-weight: bold;
    text-transform: uppercase;
    border-radius: 0;
  }

  .item.toot .category-label {
    background: #d1c4e9;
    color: #4a148c;
  }

  .item-details {
    flex: 1;
    min-width: 0;
  }

  .toot-content {
    width: 100%;
  }

  .toot-text {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-color, #333);
    white-space: pre-wrap;
    word-wrap: break-word;
  }

  .toot-text a {
    color: var(--link-color, #0066cc);
    text-decoration: none;
  }

  .toot-text a:hover {
    text-decoration: underline;
  }

  .toot-meta {
    margin-top: 0.75rem;
    font-size: 0.875rem;
  }

  .toot-meta a {
    color: var(--link-color, #0066cc);
    text-decoration: none;
  }

  .toot-meta a:hover {
    text-decoration: underline;
  }

  .empty-state {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--text-color-muted, #999);
  }

  @media (max-width: 768px) {
    .media-grid {
      gap: 0.5rem;
    }
  }
</style>
